{
  "name": "dsh-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Windows launcher for DeepSeek Harness with parallel plugin checks and change-aware caching",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests.mjs config.test.mjs service.test.mjs",
    "test:runtime": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File Test-Runtime.ps1",
    "test:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File Test-Install.ps1",
    "test:process": "node job-test.mjs --formal"
  },
  "dependencies": { "js-yaml": "4.2.0" }
}
